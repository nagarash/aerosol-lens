# Model for the agent parse step (LiteLLM model string). REQUIRED -- there is
# no default; /ask returns 501 until this is set.
# Examples: "gemini/gemini-2.0-flash", "gpt-4o-mini", "ollama/llama3.1"
LITELLM_MODEL=gemini/gemini-2.0-flash

# Provider API keys, as needed by your LITELLM_MODEL choice.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Google Air Quality API key (bring-your-own-key). The FRONTEND uses this
# directly in the browser; the backend never sees or proxies it.
# GOOGLE_AQ_API_KEY=

# Backend port (docker-compose maps host:container)
BACKEND_PORT=8000

# MERRA-2 source layout for the kerchunk index builder and grid slicer.
# Verified 2026-09-12: s3://gesdisc-cumulus-prod-protected/MERRA2, with
# per-collection dirs like M2T1NXAER.5.12.4/YYYY/MM/MERRA2_400.tavg1_2d_aer_Nx.YYYYMMDD.nc4
# (region us-west-2).
MERRA2_S3_PREFIX=s3://gesdisc-cumulus-prod-protected/MERRA2

# The GES DISC bucket is PROTECTED: anonymous S3 reads are rejected.
# Primary path: EARTHDATA_TOKEN -- a long-lived Earthdata Login bearer
# token (generate one in the Earthdata Login profile). SERVER-SIDE ONLY:
# set it via Fly.io secrets in production, never in the repo or frontend.
# The backend exchanges it for temporary S3 credentials automatically
# (cached in-process, refreshed before expiry).
# EARTHDATA_TOKEN=

# Fallback: export temporary session credentials directly (they last ~1h;
# GET https://data.gesdisc.earthdata.nasa.gov/s3credentials with your
# Earthdata Login, e.g. via the `earthaccess` library):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Set MERRA2_S3_ANON=1 only for a genuinely public mirror.
# MERRA2_S3_ANON=

# Per-IP rate limit for /grid (requests per 60s per client IP). Every /grid
# request range-reads the protected bucket against YOUR Earthdata
# credentials, so this guards your quota. Default 30.
# GRID_RATE_LIMIT_PER_MIN=30

# Path to the kerchunk manifest built by backend/kerchunk_index.py.
# /grid returns 501 until this file exists.
KERCHUNK_INDEX_PATH=./data/kerchunk/index.json
